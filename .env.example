AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://topuz-openai.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# Optional fallback if you decide to use the public OpenAI API instead of Azure OpenAI.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://topuz-openai.openai.azure.com/openai/v1
# OPENAI_MODEL=gpt-5.4-mini

# Optional per-node overrides. If unset, all chat nodes use AZURE_OPENAI_DEPLOYMENT_NAME.
# AZURE_OPENAI_CLASSIFIER_DEPLOYMENT_NAME=gpt-5.4-mini
# AZURE_OPENAI_SQL_AGENT_DEPLOYMENT_NAME=gpt-5.4-mini
# AZURE_OPENAI_ANSWER_DEPLOYMENT_NAME=gpt-5.4-mini

# Retrieval ingestion requires an embedding-capable model/deployment.
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# API security. Local demo mode stays public unless MAINTENANCE_COPILOT_ALLOW_PUBLIC=false.
MAINTENANCE_COPILOT_ALLOW_PUBLIC=true
MAINTENANCE_COPILOT_API_KEYS=demo-user-key,demo-admin-key
MAINTENANCE_COPILOT_ADMIN_KEYS=demo-admin-key
# Optional explicit key-to-role mapping. If omitted, non-admin keys are viewers.
MAINTENANCE_COPILOT_API_KEY_ROLES=demo-user-key:viewer,demo-admin-key:admin
MAINTENANCE_COPILOT_RATE_LIMIT_PER_MINUTE=20

# Production CORS must be explicit. Wildcard origins are rejected at startup.
MAINTENANCE_COPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
